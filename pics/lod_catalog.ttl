obj:c444f0e4-61ae-4e19-93e1-779305f0773b a schema1:VisualArtwork,
        crm:E22_Human_Made_Object ;
    dcterms:creator "Euthymides" ;
    dcterms:date "Um 500 v. Chr." ;
    dcterms:description "Seite A, Herakles und Dionysos: Herakles mit Löwenfell, Keule und Bogen, Dionysos mit zwei Zweigen in der linken und einem Kantharos in der rechten Hand. Zwischen beiden steht ein weiterer Kantharos. Auf der selben Ebene, vor einer Art Podest, links und rechts der beiden verschiedene Kratere, auf dem Podest, den Rest des Gefäßes umlaufend, fliehende Silene, Kleophrades-Maler laut Richter, Oltos laut Hartwig, Euthymides laut Beazley" ;
    dcterms:title "Herakles und Dionysos mit Weingefäßen und Satyrn" ;
    schema1:contentLocation "Compiègne, Musée Antoine Vivenel" ;
    schema1:locationCreated "Attisch" ;
    schema1:material "Ton" ;

th:concept_20e80681 a skos:Concept ;
    skos:broader th:concept_89023780 ;
    skos:definition "Eimerähnliches oder konisch geformtes Gefäß, oft mit Henkeln versehen und aus Bronze, Silber, Keramik, Glas oder einem anderen Material gefertigt. Es war häufig dekoriert und wurde in der Eisenzeit, im alten Ägypten, in Asien, der antiken römischen Welt und während christlicher religiöser Rituale genutzt."@de,
        "Pail-like or cone-shaped vessels, often having handles, made of bronze, silver, ceramic, glass, or another material. They were often decorated; used in the Iron Age, ancient Egypt, Asia, in the ancient Roman world, and in Christian religious rituals."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q47107> ;
    skos:inScheme th:scheme ;
    skos:prefLabel "Situla"@de,
        "Situla"@en .

